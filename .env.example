# 服务端口
PORT=8788
HOST=0.0.0.0
DEPLOYMENT_MODE=node

# 默认使用本地模拟数据。接入真实上游时设为 false，并填写基础地址。
DEMO_MODE=true
UPSTREAM_BASE_URL=
ALLOW_DYNAMIC_UPSTREAM=false

# HTTP/HTTPS 代理，可留空。示例：http://proxy.example.com:8080
HTTP_PROXY=
HTTPS_PROXY=

# 是否允许前端“系统设置”中的代理地址覆盖服务端代理。生产环境建议保持 false。
ALLOW_CLIENT_PROXY=false

# Docker 后台轮询。开启后，即使浏览器关闭也会继续监控。
MONITOR_ENABLED=false
MONITOR_INTERVAL_MINUTES=5
MONITOR_TOKEN=DEMO001
MONITOR_PRODUCT_KEY=demo-basic
MONITOR_PRODUCT_NAME=示例商品：云服务基础版
MONITOR_STATE_FILE=/data/monitor-state.json
NOTIFICATION_CONFIG_FILE=/data/notification-config.json

# 可选：服务端管理口令。留空时可在网页首次配置通知渠道时创建口令。
ADMIN_TOKEN=

# 多店铺/多商品后台监控时，填写 JSON 数组；填写后会覆盖上面的单商品配置。
# MONITOR_RULES_JSON=[{"token":"DEMO001","productKey":"demo-basic","productName":"示例商品：云服务基础版"}]

# 飞书自定义机器人 Webhook
FEISHU_WEBHOOK=

# QQ 机器人或中转服务的 Webhook
QQ_WEBHOOK=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钉钉自定义机器人 Webhook
DINGTALK_WEBHOOK=

# 企业微信群机器人 Webhook
WECOM_WEBHOOK=
