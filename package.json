{
  "name": "stock-watch-monitor",
  "private": true,
  "version": "0.1.0",
  "description": "支持 Cloudflare Worker、Docker 和 Node 的店铺库存监控台",
  "scripts": {
    "start": "node server.mjs",
    "start:node": "node server.mjs",
    "start:docker": "docker compose up -d --build",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "dev:pages": "npx wrangler pages dev .",
    "deploy:pages": "npx wrangler pages deploy .",
    "test": "node --test"
  },
  "dependencies": {
    "undici": "7.28.0"
  }
}
